* { box-sizing: border-box; }
body, div, span { display: block; }
body {
  width: 1920px; height: 1080px; margin: 0; overflow: hidden;
  background-color: #17181b; color: #ececef;
  font-family: "Montserrat"; font-weight: 500; font-size: 24px; line-height: 32px;
}
.hidden { display: none; }

#header {
  position: absolute; left: 0px; top: 0px; width: 1920px; height: 104px;
  background-color: #131416; border-bottom: 1px #2a2b30;
}
#logo { position: absolute; left: 64px; top: 20px; width: 142px; height: 64px; color: #f0386b; font-size: 36px; }
#tabs { position: absolute; left: 260px; top: 28px; width: 600px; height: 48px; }
.tab {
  display: inline-block; height: 48px; margin-right: 12px; padding: 8px 26px 0px 26px;
  border-radius: 7px; color: #9b9da4; font-size: 28px; line-height: 32px;
}
.tab.active { background-color: #f0386b; color: #ffffff; }
#clock { position: absolute; left: 1656px; top: 34px; width: 200px; height: 40px; color: #c4c5ca; font-size: 32px; line-height: 40px; text-align: right; }

#games-view { position: absolute; left: 0px; top: 105px; width: 1920px; height: 871px; }
#carousel-row { position: absolute; left: 0px; top: 110px; width: 1920px; height: 400px; }
.card { position: absolute; top: 0px; width: 300px; height: 380px; padding: 21px; background-color: #202125; border: 1px #34363c; border-radius: 10px; }
.card.selected { top: -14px; background-color: #f0386b; border: 2px #f6889f; }
.card-title { margin-top: 14px; width: 256px; height: 64px; overflow: hidden; color: #ececef; font-size: 24px; line-height: 32px; text-align: center; }
.card.selected .card-title { color: #ffffff; }
#details { position: absolute; left: 160px; top: 556px; width: 1600px; height: 120px; }
#game-title { width: 1600px; height: 48px; overflow: hidden; color: #ffffff; font-size: 40px; line-height: 48px; }
#game-meta { margin-top: 14px; width: 1600px; height: 32px; color: #9b9da4; font-size: 24px; line-height: 32px; }
#message { position: absolute; left: 160px; top: 720px; width: 1600px; height: 72px; overflow: hidden; color: #c95d5d; font-size: 24px; line-height: 32px; }
#empty { position: absolute; left: 460px; top: 230px; width: 1000px; height: 260px; padding: 40px; background-color: #202125; border: 1px #34363c; border-radius: 10px; }
.empty-title { color: #ffffff; font-size: 36px; line-height: 48px; text-align: center; }
.empty-body { margin-top: 20px; color: #9b9da4; font-size: 24px; line-height: 34px; text-align: center; }

#settings-view { position: absolute; left: 0px; top: 105px; width: 1920px; height: 871px; }
#categories { position: absolute; left: 64px; top: 40px; width: 380px; height: 640px; padding: 12px; background-color: #141518; border: 1px #2a2b30; border-radius: 10px; }
.category { height: 64px; margin-bottom: 6px; padding: 16px 20px 0px 20px; border-radius: 7px; color: #c4c5ca; font-size: 28px; line-height: 32px; }
.category.focused { background-color: #f0386b; color: #ffffff; }
.category.current { background-color: #2a2c31; color: #ffffff; border-left: 4px #f0386b; }
#panel { position: absolute; left: 476px; top: 40px; width: 1380px; height: 640px; padding: 20px 28px; background-color: #202125; border: 1px #34363c; border-radius: 10px; }
#page-title { position: absolute; left: 28px; top: 18px; width: 900px; height: 44px; color: #ffffff; font-size: 32px; line-height: 44px; }
#page-position { position: absolute; left: 1050px; top: 22px; width: 300px; height: 36px; color: #6f7178; font-size: 24px; line-height: 36px; text-align: right; }
#rows { position: absolute; left: 20px; top: 74px; width: 1340px; height: 550px; }
.row { position: relative; height: 50px; padding: 9px 16px 0px 20px; border-radius: 7px; border-bottom: 1px #212226; }
.row.focused { background-color: #2a2c31; border-left: 4px #f0386b; }
.row-name { position: absolute; left: 20px; top: 9px; width: 820px; height: 32px; overflow: hidden; color: #ececef; font-size: 24px; line-height: 32px; }
.row-value { position: absolute; left: 860px; top: 9px; width: 460px; height: 32px; overflow: hidden; color: #c4c5ca; font-size: 24px; line-height: 32px; text-align: right; }
.row.focused .row-value { color: #f45a85; }
#description { position: absolute; left: 476px; top: 700px; width: 1380px; height: 150px; padding: 14px 28px; background-color: #141518; border: 1px #2a2b30; border-radius: 10px; overflow: hidden; color: #9b9da4; font-size: 20px; line-height: 28px; }

#footer { position: absolute; left: 0px; top: 976px; width: 1920px; height: 104px; background-color: #131416; border-top: 1px #2a2b30; }
#hints { position: absolute; left: 64px; top: 30px; width: 1792px; height: 44px; text-align: right; }
.hint { display: inline-block; height: 44px; margin-left: 40px; color: #c4c5ca; font-size: 24px; line-height: 40px; }
